rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: projects
    // Document ID: auto-generated
    // Fields:
    //   - id: string (required)
    //   - name: string (required, 1-100 chars)
    //   - description: string (optional)
    //   - totalSeconds: number (required, >= 0)
    //   - isArchived: bool (required)
    //   - createdAt: number (required, immutable)
    //   - updatedAt: number (required)
    //   - uid: string (required, immutable, matches auth.uid)
    //
    // Collection: logs
    // Document ID: auto-generated
    // Fields:
    //   - id: string (required)
    //   - projectId: string (required)
    //   - seconds: number (required, > 0)
    //   - startTime: number (required)
    //   - endTime: number (required)
    //   - uid: string (required, immutable, matches auth.uid)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidProject(data) {
      return hasRequiredFields(['id', 'name', 'totalSeconds', 'isArchived', 'createdAt', 'updatedAt', 'uid']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.totalSeconds is number && data.totalSeconds >= 0 &&
             data.isArchived is bool &&
             data.uid == request.auth.uid;
    }

    function isValidLog(data) {
      return hasRequiredFields(['id', 'projectId', 'seconds', 'startTime', 'endTime', 'uid']) &&
             data.projectId is string &&
             data.seconds is number && data.seconds > 0 &&
             data.uid == request.auth.uid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /projects/{projectId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidProject(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidProject(request.resource.data) && uidNotModified() && 
                      request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isDocOwner();
    }

    match /logs/{logId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidLog(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidLog(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }
    
    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
